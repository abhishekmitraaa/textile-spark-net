{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/about", "destination": "/blogs/about", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/blogs",
      "destination": "https://cosora-blogs.vercel.app/blogs"
    },
    {
      "source": "/blogs/:path*",
      "destination": "https://cosora-blogs.vercel.app/blogs/:path*"
    },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
