{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/((?!blogs(?:/|$)).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://checkout.razorpay.com 'sha256-vAwrGKk0oqqTe+dTbvte+sn2QO+4yTPc+faYbP2v0KQ='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://vxdhhgdfubqedfpwfyrb.supabase.co https://images.unsplash.com https://picsum.photos https://fastly.picsum.photos https://*.googleusercontent.com https://cdn.razorpay.com; media-src 'self' blob: https://vxdhhgdfubqedfpwfyrb.supabase.co https://test-videos.co.uk; connect-src 'self' https://vxdhhgdfubqedfpwfyrb.supabase.co wss://vxdhhgdfubqedfpwfyrb.supabase.co https://api.bigdatacloud.net https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://www.youtube.com https://maps.google.com https://www.google.com https://api.razorpay.com https://checkout.razorpay.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; report-uri /api/csp-report; report-to csp"
        },
        {
          "key": "Reporting-Endpoints",
          "value": "csp=\"/api/csp-report\""
        }
      ]
    }
  ],
