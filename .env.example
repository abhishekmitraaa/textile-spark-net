# Copy to .env and fill in. .env is gitignored; this file is the tracked list of names.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ── Test credentials (Master Prompt 8, Phase 1) ──────────────────────────────
# None is VITE_-prefixed: Vite exposes only VITE_* to client code, and
# vite.config.ts hands DEMO_* to the dev server's account switcher only, never
# to a build. Scripts and specs read these through scripts/lib/test-credentials.mjs.
# Values: ask the project owner. In CI, set them as repository secrets.
# Never commit a value, and never paste one into documentation.

# demo-buyer@cosora.dev / demo-vendor@cosora.dev / demo-admin@cosora.dev (super_admin)
DEMO_BUYER_PASSWORD=
DEMO_VENDOR_PASSWORD=
DEMO_ADMIN_PASSWORD=
# zz-mp4-vendor@cosora.in (throwaway vendor, Master Prompt 4)
MP_VENDOR_PASSWORD=
# zz-mp5-link@cosora.in (throwaway vendor, Master Prompt 5)
MP5_LINK_PASSWORD=
# zz-test-vendor-*@cosora.in (tests/vendor-signup.spec.ts creates these)
TEST_VENDOR_PASSWORD=
# rlstest-* / chatfx-* fixtures: seeded for a run, then dropped (see Cosora-Admin README)
FIXTURE_PASSWORD=
